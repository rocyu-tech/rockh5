# =============================================================================
# RockH5 Environment Variables — Example
#
# Copy this file to `.env.local` (for local dev) or set the variables in your
# deployment environment (Docker / PM2 / Kubernetes / etc).
#
# Next.js automatically loads `.env.local` for `next dev` and `next build`.
# For production, set the variables in your process manager or container.
# =============================================================================

# Backend API base URL.
# - Local dev:     http://localhost:8880
# - Staging:       https://api-staging.your-domain.com
# - Production:    https://api.your-domain.com
#
# This value is used by next.config.ts rewrites to proxy /api/v1/* requests
# to the Go backend (rockgame). NEVER hard-code production IPs in source.
BACKEND_URL=http://localhost:8880

# Public site URL (used for SEO / Open Graph / canonical URLs).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Sentry DSN (leave empty to disable error reporting).
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics (leave empty to disable).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

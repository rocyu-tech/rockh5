# ---------------------------------------------------------------------------
# Server-side only (NOT exposed to the browser).
# Used by next.config.ts rewrites to proxy /api/v1/* and /ws/v1/* to the backend.
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8880

# ---------------------------------------------------------------------------
# Optional: client-side override for the WS base URL.
# Only used by the getWSBaseURL() helper in src/lib/ws.ts, which is currently
# unused (all 4 play pages use relative /ws/v1/* URLs that go through the
# Next.js rewrite). Leave commented out to keep using the same-origin proxy.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8880
